{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://morphogenesis.local/schemas/run.schema.json",
  "title": "Experiment run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "experiment", "status", "started_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$"},
    "experiment": {"type": "string"},
    "experiment_id": {"type": ["string", "null"]},
    "arm": {"type": ["string", "null"]},
    "seed": {"type": ["integer", "null"]},
    "steps": {"type": ["integer", "null"]},
    "status": {"enum": ["claimed", "running", "finished", "failed", "aborted", "superseded"]},
    "provenance": {"enum": ["journal-reconstructed", "runner", "manual"]},
    "source": {"type": ["string", "null"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "git_commit": {"type": ["string", "null"]},
    "git_dirty": {"type": ["boolean", "null"]},
    "command": {"type": ["array", "null"], "items": {"type": "string"}},
    "cwd": {"type": "string"},
    "owner": {"type": ["string", "null"]},
    "environment": {"type": "object"},
    "checkpoint_in": {"type": ["object", "null"]},
    "outputs": {"type": "object"},
    "metrics": {"type": "object"},
    "stop_reason": {"type": ["string", "null"]},
    "exit_code": {"type": ["integer", "null"]},
    "log_path": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
