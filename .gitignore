# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# NOTE: lib/, var/ и подобные паттерны нужны только для build-артефактов,
# но они могли бы проглотить исходники проекта (morphogenesis/utils/...).
# Ограничиваем их корнем репозитория.
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Виртуальные окружения
.venv/
venv-cuda/
env/
bin/
include/
pyvenv.cfg

# Веса и чекпоинты моделей (политика отката §13: хранятся локально, не в git)
*.pt
*.pth
*.ckpt

# TensorBoard
*/logs/
logs/
*.tfevents*
events.out.tfevents.*

# Кадры и выходные артефакты прогонов
morphogenesis/outputs/frames/
morphogenesis/outputs/cognition_frames/
morphogenesis/outputs/eval/
morphogenesis/experiments/*/frame_*.png

# Логи прогонов
*.log
morphogenesis/logs/*.jsonl
# Канонический журнал лаборатории — единственный файл logs/, который живёт в git.
# Он append-only, маленький (десятки КБ) и нужен для проверки пар start/finish
# на свежем клоне. Per-run JSONL и TensorBoard по-прежнему не коммитятся.
!/morphogenesis/logs/
morphogenesis/logs/*
!/morphogenesis/logs/journal.jsonl
# Преходящий stdout диагностических прогонов (перенаправление `> logs_gate_*.txt`,
# `> logs_wp4_*.txt`); воспроизводится командами `python gate_layer1.py` и
# `python wp4_ablations.py`, в git не нужен — машинный результат лежит в
# experiments/E02_pattern/*.json.
morphogenesis/logs_gate_*.txt
morphogenesis/logs_wp4_*.txt
# То же, но перенаправленное в корень репозитория (`> ../logs_gate_800.txt`):
# относительные пути в config.py привязаны к morphogenesis/, и stdout-лог легко
# оказывается на уровень выше. Машинный результат лежит в experiments/*.json.
/logs_gate_*.txt
/logs_wp4_*.txt
# То же для волн wave7/8/9 (stdout прогонов wp4_ablations.py, `> ../logs_wave9_*.txt`).
/logs_wave*.txt
# То же для зонда достижимости/удержания (`> ../logs_reach_s2000.txt`).
/logs_reach_*.txt
/pytest_*.txt
/nohup.out

# Преходящее runtime-состояние (не знание агента)
morphogenesis/memory/current_state.json
morphogenesis/reports/

# Замки запусков: живут только на машине, которая сейчас пишет эксперимент.
# Манифесты прогонов (lab/runs/*.json) наоборот коммитятся.
lab/locks/*.lock

# Архив завершённых per-run JSONL для GitHub. TensorBoard и stdout обёртки
# остаются локальными; глобальный паттерн logs/ не должен скрывать этот каталог.
!/lab/logs/
!/lab/logs/**

# Артефакты, которые возникают в КОРНЕ репозитория, если запустить pytest или
# прогон с неверного CWD (все пути в config.py относительные). Игнорируем, чтобы
# случайный мусор не попал в индекс; правильный запуск — из morphogenesis/
# (см. run_tests.py и morphogenesis/conftest.py).
/memory/
/outputs/
# В корне reports/ — публичный лабораторный журнал (README, TEMPLATE и
# датированные карточки экспериментов). Runtime-отчёты когнитивного контура
# (report_NNNN.md, summary_latest.md, failures_log.md) по-прежнему не попадают
# в git; при правильном запуске из morphogenesis/ они пишутся в
# morphogenesis/reports/, который игнорируется выше.
/reports/*
!/reports/README.md
!/reports/TEMPLATE.md
!/reports/20[0-9][0-9]-[0-1][0-9]-[0-3][0-9]-*.md
!/reports/figures/
!/reports/figures/**
# Генерируемые служебные отчёты контура: их пишут lab_health.py и farm_reader.py,
# они фиксированные по имени (а не датированные), поэтому нужны отдельные исключения.
# Без них гейт «отчёт обязан быть в индексе» не мог выполняться, а внешний workflow
# не мог закоммитить статус (падение `git add` → письма об ошибках, 26.10).
!/reports/health.md
!/reports/farm-latest.md
!/reports/ci-status.json
/experiments/
/checkpoints/
*.tmp

# Environment
.env
.env.local
.env.*

# Coverage
.coverage
htmlcov/
.coverage.*
coverage.xml
*.cover

# Testing
.pytest_cache/
.hypothesis/

# Рабочие построчные файлы ночных повторов E02b: построчная запись нужна для
# устойчивости к обрыву длинного прогона, но итоговый JSON содержит все строки
# целиком, поэтому в git эти файлы не нужны.
morphogenesis/experiments/E02b_morphospace/*_rows.jsonl

# Portable inference-пакет E02b (scripts/export_portable.py): собирается
# локально, содержит lite-веса (.pt) и 15-МБ census. В git едут только скрипты
# сборки/проверки и kaggle/-ассеты; паттерн `dist/` выше уже покрывает каталог,
# явное правило — чтобы сборка не попала в индекс при правке секции Python.
/dist/

# IDE / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

